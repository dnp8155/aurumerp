{
  "name": "VendorPricingRule",
  "type": "object",
  "properties": {
    "vendor_id": {
      "type": "string",
      "title": "Vendor ID",
      "relation": "Vendor"
    },
    "vendor_name": {
      "type": "string",
      "title": "Vendor Name"
    },
    "rule_name": {
      "type": "string",
      "title": "Rule Name"
    },
    "version_number": {
      "type": "number",
      "default": 1,
      "title": "Version Number"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "Is Active"
    },
    "steps": {
      "type": "array",
      "title": "Calculation Steps",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "number"
          },
          "operation": {
            "type": "string",
            "enum": [
              "multiply",
              "divide",
              "add",
              "subtract"
            ]
          },
          "operand": {
            "type": "number"
          }
        }
      }
    },
    "effective_from": {
      "type": "string",
      "format": "date",
      "title": "Effective From"
    },
    "effective_to": {
      "type": "string",
      "format": "date",
      "title": "Effective To"
    },
    "created_by": {
      "type": "string",
      "title": "Created By"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "title": "Status"
    }
  },
  "required": [
    "vendor_id",
    "rule_name",
    "version_number"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}