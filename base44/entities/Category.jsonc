{
  "name": "Category",
  "type": "object",
  "properties": {
    "vertical": {
      "type": "string",
      "enum": [
        "Art Jewellery",
        "Bangles"
      ],
      "title": "Vertical"
    },
    "name": {
      "type": "string",
      "title": "Category Name"
    },
    "parent_category_id": {
      "type": "string",
      "title": "Parent Category ID",
      "relation": "Category"
    },
    "parent_category_name": {
      "type": "string",
      "title": "Parent Category"
    },
    "sub_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Sub Categories"
    },
    "is_set": {
      "type": "boolean",
      "default": false,
      "title": "Is a Set (e.g., Bangle Set)"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "title": "Display Order"
    }
  },
  "required": [
    "vertical",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}