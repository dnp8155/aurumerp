{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "title": "PO Number"
    },
    "vendor_id": {
      "type": "string",
      "title": "Vendor ID",
      "relation": "Vendor"
    },
    "vendor_name": {
      "type": "string",
      "title": "Vendor Name"
    },
    "vendor_gst_number": {
      "type": "string",
      "title": "Vendor GST Number"
    },
    "vendor_gst_pricing_type": {
      "type": "string",
      "enum": [
        "exclusive",
        "inclusive"
      ],
      "default": "exclusive",
      "title": "Vendor Default GST Pricing Type"
    },
    "company_gst_registration_id": {
      "type": "string",
      "title": "Company GST Registration ID",
      "relation": "GstRegistration"
    },
    "company_gst_number": {
      "type": "string",
      "title": "Company GST Number"
    },
    "store_id": {
      "type": "string",
      "title": "Receiving Store ID",
      "relation": "Store"
    },
    "store_name": {
      "type": "string",
      "title": "Receiving Store"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "rejected",
        "partially_received",
        "received",
        "cancelled"
      ],
      "default": "pending_approval",
      "title": "Status"
    },
    "items": {
      "type": "array",
      "title": "PO Items",
      "items": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "vendor_sku_code": {
            "type": "string"
          },
          "product_code": {
            "type": "string"
          },
          "short_code": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "total_price": {
            "type": "number"
          },
          "gst_rate": {
            "type": "number",
            "default": 3,
            "title": "GST Rate (%)"
          },
          "gst_amount": {
            "type": "number",
            "default": 0,
            "title": "GST Amount"
          },
          "gst_pricing_type": {
            "type": "string",
            "enum": [
              "exclusive",
              "inclusive"
            ],
            "default": "exclusive",
            "title": "GST Pricing Type"
          },
          "selling_price": {
            "type": "number",
            "default": 0,
            "title": "Selling Price (Manual)"
          },
          "taxable_amount": {
            "type": "number",
            "default": 0,
            "title": "Taxable/Base Amount"
          },
          "pricing_mode": {
            "type": "string",
            "enum": [
              "automatic",
              "manual_override"
            ],
            "default": "automatic"
          },
          "pricing_rule_id": {
            "type": "string"
          },
          "pricing_rule_version": {
            "type": "number"
          },
          "calculated_price": {
            "type": "number",
            "default": 0
          },
          "manual_override_price": {
            "type": "number"
          },
          "final_price": {
            "type": "number",
            "default": 0
          },
          "override_reason": {
            "type": "string"
          },
          "override_user": {
            "type": "string"
          },
          "calculation_timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "calculated_value": {
            "type": "number",
            "default": 0
          },
          "p_value": {
            "type": "number",
            "default": 0
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0,
      "title": "Subtotal"
    },
    "subtotal_before_gst": {
      "type": "number",
      "default": 0,
      "title": "Subtotal Before GST"
    },
    "gst_type": {
      "type": "string",
      "enum": [
        "intra",
        "inter"
      ],
      "default": "intra",
      "title": "GST Type"
    },
    "cgst_amount": {
      "type": "number",
      "default": 0,
      "title": "CGST Amount"
    },
    "sgst_amount": {
      "type": "number",
      "default": 0,
      "title": "SGST Amount"
    },
    "igst_amount": {
      "type": "number",
      "default": 0,
      "title": "IGST Amount"
    },
    "total_gst_amount": {
      "type": "number",
      "default": 0,
      "title": "Total GST Amount"
    },
    "tax_amount": {
      "type": "number",
      "default": 0,
      "title": "Tax Amount (GST)"
    },
    "total_amount": {
      "type": "number",
      "default": 0,
      "title": "Total Amount"
    },
    "total_with_gst": {
      "type": "number",
      "default": 0,
      "title": "Total With GST"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "approved_by": {
      "type": "string",
      "title": "Approved By"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time",
      "title": "Approved Date"
    },
    "tally_synced": {
      "type": "boolean",
      "default": false,
      "title": "Tally Synced"
    },
    "tally_sync_date": {
      "type": "string",
      "format": "date-time",
      "title": "Tally Sync Date"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "partial",
        "paid"
      ],
      "default": "unpaid",
      "title": "Payment Status"
    },
    "payable_amount": {
      "type": "number",
      "default": 0,
      "title": "Vendor Payable Amount"
    },
    "payment_due_date": {
      "type": "string",
      "format": "date",
      "title": "Payment Due Date"
    },
    "auto_pay_enabled": {
      "type": "boolean",
      "default": false,
      "title": "Auto-Pay Enabled (Scheduled Workflow)"
    },
    "payout_id": {
      "type": "string",
      "title": "RazorpayX Payout ID"
    },
    "payout_status": {
      "type": "string",
      "title": "Payout Status (RazorpayX)"
    },
    "payout_date": {
      "type": "string",
      "format": "date-time",
      "title": "Payout Date"
    },
    "payout_mode": {
      "type": "string",
      "enum": [
        "IMPS",
        "NEFT",
        "UPI",
        "RTGS"
      ],
      "title": "Payout Mode"
    }
  },
  "required": [
    "po_number",
    "vendor_id"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}