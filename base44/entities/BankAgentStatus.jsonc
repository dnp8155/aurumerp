{
  "name": "BankAgentStatus",
  "type": "object",
  "properties": {
    "agent_version": {
      "type": "string",
      "title": "Agent Version"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "title": "Last Heartbeat (Agent)"
    },
    "bank_connected": {
      "type": "boolean",
      "default": false,
      "title": "Bank API Reachable (from agent)"
    },
    "bank_provider": {
      "type": "string",
      "title": "Bank Provider"
    },
    "bank_response": {
      "type": "string",
      "title": "Last Bank Response Snippet"
    },
    "pending_count": {
      "type": "number",
      "default": 0,
      "title": "Pending Jobs (reported by agent)"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected"
      ],
      "default": "disconnected",
      "title": "Status"
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}